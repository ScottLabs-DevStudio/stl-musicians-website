{
  "framework": "nextjs",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.stl-musicians.com"
        }
      ],
      "destination": "https://stl-musicians.com/:path*",
      "permanent": true
    }
  ],
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] || echo \"$VERCEL_GIT_COMMIT_MESSAGE\" | grep -qF \"[preview]\"; then bash scripts/vercel-ignore-build.sh; else exit 0; fi",
  "git": {
    "deploymentEnabled": {
      "docs/*": false,
      "standards/*": false
    }
  }
}
